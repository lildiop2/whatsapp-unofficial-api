{
  "name": "zap-zap-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for the unofficial WhatsApp REST API and Management Dashboard",
  "workspaces": [
    "apps/api",
    "apps/dashboard",
    "apps/worker",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,js,json,vue,md}\" --ignore-path .gitignore && npx prisma format --schema=apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3"
  }
}
