# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5444/zap_zap?schema=public"

# Cache & Locks
REDIS_URL="redis://localhost:6379/0"

# Message Broker
RABBITMQ_URL="amqp://localhost:5672"

# API Server Configuration
PORT=3002
LOG_LEVEL=info
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET="zapzap_super_secret_jwt_token_key_999"

# Frontend Dashboard API Endpoint (Vite)
VITE_API_BASE_URL="http://localhost:3002"

# AI/LLM Provider configuration (Platform defaults / Fallback)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""

# S3 / MinIO Storage Configuration (Optional, falls back to local folder serving)
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_BUCKET_NAME="zap-zap"
# S3_REGION="us-east-1"
# S3_FORCE_PATH_STYLE="true"
# S3_PUBLIC_URL="http://localhost:9000/zap-zap"

# Public API URL for local media access fallback links
# API_PUBLIC_URL="http://localhost:3002"
