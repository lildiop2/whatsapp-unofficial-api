# Stage 1: Build
FROM node:20-slim AS builder
WORKDIR /app

# Copiar arquivos de workspace
COPY package.json package-lock.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/worker/package.json ./apps/worker/

# Instalar dependências usando npm workspaces
RUN npm ci

# Copiar código-fonte
COPY packages/shared ./packages/shared
COPY apps/worker ./apps/worker

# Build TypeScript
RUN npm run build --workspace=@zap/shared
RUN npm run build --workspace=apps/worker

# Prunar dependências de desenvolvimento
RUN npm prune --omit=dev --workspace=apps/worker

# Stage 2: Runner
FROM node:20-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copiar dependências de produção do builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder /app/apps/worker/package.json ./apps/worker/package.json

CMD ["node", "apps/worker/dist/index.js"]
