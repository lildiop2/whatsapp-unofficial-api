# Stage 1: Build
FROM node:20-slim AS builder
WORKDIR /app

# Instalar dependências para compilar typescript se necessário
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# Copiar arquivos de workspace
COPY package.json package-lock.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/dashboard/package.json ./apps/dashboard/

# Instalar dependências usando npm workspaces
RUN npm ci

# Copiar código-fonte
COPY packages/shared ./packages/shared
COPY apps/dashboard ./apps/dashboard

# Executar build de produção do painel Vue 3
RUN npm run build --workspace=@zap/shared
RUN npm run build --workspace=apps/dashboard

# Stage 2: Runner
FROM nginx:alpine AS runner

# Copiar build estático do Vue 3 para o diretório padrão do Nginx
COPY --from=builder /app/apps/dashboard/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
